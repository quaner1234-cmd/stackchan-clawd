+    preview_started=esp_timer_get_time();
+    printf("CLAWD PHOTO_PREVIEW shown duration_ms=5000 rgb_crc=%lu jpeg_crc=%lu\n",
+           (unsigned long)esp_crc32_le(0,pixels,size),
+           (unsigned long)esp_crc32_le(0,jpeg.data(),jpeg.size()));
