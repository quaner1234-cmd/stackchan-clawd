+    lv_obj_set_pos(preview,0,0);
+    lv_obj_remove_flag(preview,LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(preview,LV_OBJ_FLAG_SCROLLABLE);
