+bool StackChanCamera::GrabFrame()
+{
+    if (encoder_thread_.joinable()) {
+        encoder_thread_.join();
+    }
+
+    if (!streaming_on_ || video_fd_ < 0) {
+        return false;
+    }
+
+    // Drop the frames already queued so the returned image is the current scene,
+    // not one buffered before the child asked the question.
+    for (int i = 0; i < 3; i++) {
+        struct v4l2_buffer buf = {};
+        buf.type               = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        buf.memory             = V4L2_MEMORY_MMAP;
+        if (ioctl(video_fd_, VIDIOC_DQBUF, &buf) != 0) {
+            ESP_LOGE(TAG, "VIDIOC_DQBUF failed");
+            return false;
+        }
+        if (i == 2) {
+            if (frame_.data) {
+                heap_caps_free(frame_.data);
+                frame_.data   = nullptr;
+                frame_.format = 0;
+            }
+            frame_.len  = buf.bytesused;
+            frame_.data = (uint8_t*)heap_caps_malloc(frame_.len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+            if (!frame_.data) {
+                ESP_LOGE(TAG, "alloc frame copy failed: need %lu bytes", buf.bytesused);
+                if (ioctl(video_fd_, VIDIOC_QBUF, &buf) != 0) {
+                    ESP_LOGE(TAG, "Cleanup: VIDIOC_QBUF failed");
+                }
+                return false;
+            }
+            memcpy(frame_.data, mmap_buffers_[buf.index].start,
+                   MIN(mmap_buffers_[buf.index].length, frame_.len));
+            // The sensor is configured for YUV422 (delivered as packed YUYV).
+            frame_.format = (sensor_format_ == V4L2_PIX_FMT_YUV422P) ? V4L2_PIX_FMT_YUYV : sensor_format_;
+        }
+        if (ioctl(video_fd_, VIDIOC_QBUF, &buf) != 0) {
+            ESP_LOGE(TAG, "VIDIOC_QBUF failed");
+            return false;
+        }
+    }
+    return frame_.data != nullptr;
+}
