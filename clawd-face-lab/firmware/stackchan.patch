+    shutter_sound();
+    if (cancelled) {printf("CLAWD PHOTO_ERROR cancelled\n");return;}
+    if (!camera->GrabFrame()) {
+        printf("CLAWD PHOTO_ERROR capture_failed\n");
+        fflush(stdout);
+        return;
+    }
+
+    uint8_t* frame = const_cast<uint8_t*>(camera->GetFrameData());
+    const size_t frame_size = camera->GetFrameSize();
+    const auto width = static_cast<uint16_t>(camera->GetFrameWidth());
+    const auto height = static_cast<uint16_t>(camera->GetFrameHeight());
+    const auto format = static_cast<v4l2_pix_fmt_t>(camera->GetFrameFormat());
+
+    JpegOutput jpeg;
+    jpeg.bytes.reserve(32 * 1024);
+    const int64_t started = esp_timer_get_time();
+    bool ok = encode_frame(frame, frame_size, width, height, format, &jpeg);
+    const int64_t elapsed = esp_timer_get_time() - started;
+    if (!ok || jpeg.overflow || jpeg.bytes.empty() || elapsed > kEncodeTimeoutUs) {
+        printf("CLAWD PHOTO_ERROR encode_failed ok=%d overflow=%d bytes=%u elapsed_ms=%d\n",
+               int(ok), int(jpeg.overflow), unsigned(jpeg.bytes.size()), int(elapsed / 1000));
+        fflush(stdout);
+        return;
+    }
+
+    if (cancelled) {printf("CLAWD PHOTO_ERROR cancelled\n");return;}
+    if (!show_preview(jpeg.bytes) && !cancelled)
+        printf("CLAWD PHOTO_PREVIEW failed\n");
+    if (cancelled) {printf("CLAWD PHOTO_ERROR cancelled\n");return;}
+    const uint32_t crc = esp_crc32_le(0, jpeg.bytes.data(), jpeg.bytes.size());
+    // One locked block: the host validates the header, the length, the CRC and the footer.
+    flockfile(stdout);
+    printf("CLAWD_PHOTO %u %u %u %lu\n", unsigned(width), unsigned(height),
+           unsigned(jpeg.bytes.size()), (unsigned long)crc);
+    fflush(stdout);
+    size_t sent = 0;
+    const int64_t deadline = esp_timer_get_time() + 15 * 1000 * 1000;
+    while (sent < jpeg.bytes.size() && esp_timer_get_time() < deadline) {
+        const size_t chunk = std::min<size_t>(4096, jpeg.bytes.size() - sent);
+        const int written = usb_serial_jtag_write_bytes(jpeg.bytes.data() + sent, chunk,
+                                                        pdMS_TO_TICKS(250));
+        if (written > 0) {
+            sent += size_t(written);
+        }
+    }
+    printf("\nCLAWD_PHOTO_END\n");
+    fflush(stdout);
+    funlockfile(stdout);
+
+    printf("CLAWD PHOTO_DONE bytes=%u elapsed_ms=%d sent=%u\n", unsigned(jpeg.bytes.size()),
+           int(elapsed / 1000), unsigned(sent));
+    fflush(stdout);
+}
+
+void capture_task(void*)
+{
+    // Return through C++ scopes before deleting the task so JPEG buffers are freed.
+    capture_once();
+    fflush(stdout);
+    busy=false;
+    vTaskDelete(nullptr);
+}
+}  // namespace
+
+bool capture()
+{
+    if (busy.exchange(true)) {
+        return false;
+    }
+    requested = false;
+    cancelled = false;
+    if (xTaskCreate(capture_task, "clawd_photo", kCaptureStack, nullptr, kCapturePriority, nullptr) !=
+        pdPASS) {
+        busy = false;
+        return false;
+    }
+    return true;
+}
+
+void update_preview()
+{
+    if (preview && esp_timer_get_time()-preview_started>=kPreviewUs)
+        clear_preview("timeout");
+}
+
+void cancel()
+{
+    cancelled=true;
+    clear_preview("cancelled");
+}
+
+bool preview_visible() {return preview!=nullptr;}
+}  // namespace clawd_camera
diff --git a/firmware/main/hal/clawd_camera.h b/firmware/main/hal/clawd_camera.h
new file mode 100644
index 0000000..2c2d606
--- /dev/null
+++ b/firmware/main/hal/clawd_camera.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace clawd_camera {
+// Set by the USB command loop when the host asks for a photo.
+extern std::atomic<bool> requested;
+// True while a capture task owns stdout and the sensor.
+extern std::atomic<bool> busy;
+
+// Grab one frame and stream it to the host as a JPEG frame.
+// The frame is written to stdout with the same framing style as CLAWD_FRAME:
+//   CLAWD_PHOTO <width> <height> <bytes> <crc32>
+//   <JPEG bytes>
+//   \nCLAWD_PHOTO_END\n
+// Callers must not hold the LVGL lock; this spawns its own task.
+bool capture();
+// The following UI functions run under the caller's LVGL lock.
+void update_preview();
+void cancel();
+bool preview_visible();
+}
diff --git a/firmware/main/hal/clawd_chat_motion.h b/firmware/main/hal/clawd_chat_motion.h
new file mode 100644
index 0000000..843b682
--- /dev/null
+++ b/firmware/main/hal/clawd_chat_motion.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <stackchan/stackchan.h>
+
+// A finite gesture per spoken answer. Angles use the HAL's tenths of a degree.
+// Read the current pose each time; never seek an absolute home or rotate in PWM.
+class ClawdChatMotion {
+public:
+    void update(bool speaking, uint32_t now, uint32_t speech_ms)
+    {
+        if (!speaking) {
+            stop("quiet");
+            was_speaking_ = false;
+            return;
+        }
+        if (!was_speaking_) {
+            was_speaking_ = true;
+            start(now, speech_ms);
+        }
+        if (!active_) return;
+        const uint32_t elapsed = now - started_;
+        const int next = elapsed / 600;
+        const int end = nod_ ? 2 : 3;
+        if (next >= end) {
+            stop("complete");
+        } else if (next != stage_) {
+            stage_ = next;
+            target(stage_ == end - 1 ? base_ : base_ - direction_ * 45);
+        }
+    }
+
+    void stop(const char* reason)
+    {
+        if (!active_) return;
+        auto& motion = GetStackChan().motion();
+        motion.yawServo().stopAndRelease();
+        motion.pitchServo().stopAndRelease();
+        active_ = false;
+        printf("CLAWD MOTION stopped reason=%s\n", reason);
+        metadata();
+    }
+
+    void metadata()
+    {
+        auto& motion = GetStackChan().motion();
+        printf("CLAWD MOTION_STATUS active=%d yaw=%d pitch=%d yaw_torque=%d pitch_torque=%d\n",
+               int(active_), motion.getCurrentYawAngle(), motion.getCurrentPitchAngle(),
+               int(motion.yawServo().getTorqueEnabled()), int(motion.pitchServo().getTorqueEnabled()));
+    }
+
+private:
+    bool active_ = false, was_speaking_ = false, nod_ = true;
+    unsigned sequence_ = 0;
+    int base_ = 0, direction_ = 1, stage_ = 0;
+    uint32_t started_ = 0;
+    stackchan::motion::Servo* servo_ = nullptr;
+
+    void target(int angle)
+    {
+        const auto limits = servo_->getAngleLimit();
+        angle = std::clamp(angle, limits.x, limits.y);
+        printf("CLAWD MOTION kind=%s stage=%d actual=%d target=%d base=%d\n",
+               nod_ ? "nod" : "sway", stage_, servo_->getCurrentAngle(), angle, base_);
+        servo_->moveWithSpeed(angle, 500);
+    }
+
+    void start(uint32_t now, uint32_t speech_ms)
+    {
+        if (speech_ms < 1400) return;  // Leave enough time to return before the mic opens.
+        auto& motion = GetStackChan().motion();
+        nod_ = speech_ms < 2000 || sequence_ % 2 == 0;
+        direction_ = sequence_ % 4 < 2 ? 1 : -1;
+        ++sequence_;
+        servo_ = nod_ ? &motion.pitchServo() : &motion.yawServo();
+        base_ = servo_->getCurrentAngle();
+        const auto limits = servo_->getAngleLimit();
+        const int amount = nod_ ? 30 : 45;
+        // Prefer the side with room when the current pose is near a limit.
+        if (base_ + direction_ * amount < limits.x || base_ + direction_ * amount > limits.y)
+            direction_ = -direction_;
+        const int first = std::clamp(base_ + direction_ * amount, limits.x, limits.y);
+        if (std::abs(first - base_) < 10) return;
+        motion.setAutoAngleSyncEnabled(true);
+        servo_->setTorqueEnabled(true);
+        stage_ = 0;
+        started_ = now;
+        active_ = true;
+        target(first);
+    }
+};
diff --git a/firmware/main/hal/clawd_dance.h b/firmware/main/hal/clawd_dance.h
new file mode 100644
index 0000000..55a3e6a
--- /dev/null
+++ b/firmware/main/hal/clawd_dance.h
@@ -0,0 +1,113 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdio>
+#include <stackchan/stackchan.h>
+
+// Ten gentle beats, relative to the current pose. Units are tenths of a degree.
+// The final two beats settle at the starting pose before releasing both motors.
+class ClawdDance {
+public:
+    bool active() const { return active_; }
+
+    void start(uint32_t now)
+    {
+        auto& motion = GetStackChan().motion();
+        base_yaw_ = motion.getCurrentYawAngle();
+        base_pitch_ = motion.getCurrentPitchAngle();
+        motion.setAutoAngleSyncEnabled(true);
+        // Hold yaw between beats so its early auto-release cannot interrupt centering.
+        // Pitch keeps its normal auto-release and stall protection.
+        motion.yawServo().setAutoTorqueReleaseEnabled(false);
+        motion.setTorqueEnabled(true);
+        active_ = true;
+        started_ = now;
+        stage_ = 0;
+        printf("CLAWD DANCE_START duration_ms=8000 name=crab1\n");
+        target();
+        // Sync once at entry, then preserve the continuous trajectory between beats.
+        motion.setAutoAngleSyncEnabled(false);
+    }
+
+    void update(uint32_t now)
+    {
+        if (!active_) return;
+        if (now - started_ >= 8000) {
+            finish(now, false, "complete");
+            return;
+        }
+        const unsigned next = (now - started_) / 800;
+        if (next != stage_) {
+            stage_ = next;
+            target();
+        }
+    }
+
+    void stop(uint32_t now, const char* reason)
+    {
+        if (active_) finish(now, true, reason);
+    }
+
+    void metadata()
+    {
+        auto& motion = GetStackChan().motion();
+        printf("CLAWD DANCE_STATUS active=%d yaw=%d pitch=%d yaw_torque=%d pitch_torque=%d\n",
+               int(active_), motion.getCurrentYawAngle(), motion.getCurrentPitchAngle(),
+               int(motion.yawServo().getTorqueEnabled()), int(motion.pitchServo().getTorqueEnabled()));
+    }
+
+private:
+    bool active_ = false;
+    uint32_t started_ = 0;
+    unsigned stage_ = 0;
+    int base_yaw_ = 0, base_pitch_ = 0;
+
+    void target()
+    {
+        // Left/right, left/right, two nods, then a two-beat finish.
+        static constexpr int yaw[]   = {-60, 60, -60, 60, 0, 0, 0, 0, 0, 0};
+        static constexpr int pitch[] = {0, 20, 0, 20, 40, 0, 40, 0, 0, 0};
+        auto& motion = GetStackChan().motion();
+        const auto yl = motion.yawServo().getAngleLimit();
+        const auto pl = motion.pitchServo().getAngleLimit();
+        int yaw_offset = yaw[stage_];
+        // A measured physical offset can remain even with software on target.
+        // One bounded settling move, then the final beat restores the baseline.
+        if (stage_ == 8) {
+            const int error = motion.getCurrentYawAngle() - base_yaw_;
+            if (std::abs(error) > 15) {
+                const int correction = std::clamp(std::abs(error) + 6, 30, 45);
+                yaw_offset = error > 0 ? -correction : correction;
+                printf("CLAWD DANCE_SETTLE error=%d offset=%d\n", error, yaw_offset);
+            }
+        }
+        const int y = std::clamp(base_yaw_ + yaw_offset, yl.x, yl.y);
+        const int p = std::clamp(base_pitch_ + pitch[stage_], pl.x, pl.y);
+        printf("CLAWD DANCE_TRACE stage=%u software_yaw=%d yaw_torque=%d\n",
+               stage_, motion.yawServo().stackchan::motion::Servo::getCurrentAngle(), int(motion.yawServo().getTorqueEnabled()));
+        printf("CLAWD DANCE_STAGE stage=%u yaw=%d pitch=%d target_yaw=%d target_pitch=%d base_yaw=%d base_pitch=%d\n",
+               stage_, motion.getCurrentYawAngle(), motion.getCurrentPitchAngle(), y, p, base_yaw_, base_pitch_);
+        // Avoid restarting a trajectory during the final settling beats.
+        if (stage_ == 0 || stage_ >= 8 || yaw[stage_] != yaw[stage_ - 1]) {
+            motion.yawServo().setTorqueEnabled(true);
+            motion.moveYawWithSpeed(y, 500);
+        }
+        if (stage_ == 0 || pitch[stage_] != pitch[stage_ - 1]) {
+            motion.pitchServo().setTorqueEnabled(true);
+            motion.movePitchWithSpeed(p, 500);
+        }
+    }
+
+    void finish(uint32_t now, bool cancelled, const char* reason)
+    {
+        auto& motion = GetStackChan().motion();
+        motion.setAutoAngleSyncEnabled(true);
+        motion.yawServo().setAutoTorqueReleaseEnabled(true);
+        motion.yawServo().stopAndRelease();
+        motion.pitchServo().stopAndRelease();
+        active_ = false;
+        printf("CLAWD DANCE_DONE cancelled=%d elapsed_ms=%lu reason=%s\n", int(cancelled),
+               (unsigned long)(now - started_), reason);
+        metadata();
+    }
+};
diff --git a/firmware/main/hal/clawd_idle_scenes.h b/firmware/main/hal/clawd_idle_scenes.h
